# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage 1 — builder: resolve as dependências em um virtualenv isolado
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=2.4.3 \
    POETRY_VIRTUALENVS_CREATE=false \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /build

RUN pip install "poetry==${POETRY_VERSION}" && python -m venv /opt/venv

COPY pyproject.toml poetry.lock ./

RUN poetry install --only main --no-root

# ---------------------------------------------------------------------------
# Stage 2 — runtime: só o virtualenv e o código da aplicação
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# O nó StringNormalizer do grafo ONNX abre a locale en_US.UTF-8 ao inicializar
# a sessão. A imagem slim não traz nenhuma locale gerada, e a ausência derruba
# o serviço no boot — daí gerá-la explicitamente aqui.
RUN apt-get update \
    && apt-get install -y --no-install-recommends locales \
    && sed -i '/^# *en_US.UTF-8 UTF-8/s/^# *//' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN groupadd --system app && useradd --system --gid app --create-home app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY src/ ./src/
COPY scripts/ ./scripts/

RUN mkdir -p data/raw data/processed models metrics reports && \
    chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"

CMD ["uvicorn", "src.app.api:app", "--host", "0.0.0.0", "--port", "8000"]
