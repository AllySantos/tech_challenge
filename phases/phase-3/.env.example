# Copie para .env e ajuste conforme necessário. O .env é gitignored.

# === Backend de inferência da API: sklearn | onnx | onnx-int8 | onnx-pruned ===
INFERENCE_BACKEND=onnx-pruned

# === Reprodutibilidade ===
RANDOM_SEED=42

# === Caminhos ===
# Caminhos relativos são resolvidos contra a raiz do projeto, não contra o
# diretório de trabalho do processo. Deixe PROJECT_ROOT em branco para que ela
# seja deduzida automaticamente.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
METRICS_DIR=metrics
REPORTS_DIR=reports

# === Treino ===
VALIDATION_SIZE=0.15
TFIDF_MAX_FEATURES=30000
TFIDF_MIN_DF=3
TFIDF_NGRAM_MAX=2
LOGREG_C=4.0

# Termos mantidos após o pruning do vocabulário
PRUNE_KEEP_FEATURES=10000

# === Portões de qualidade do retreino ===
MIN_MACRO_F1=0.60
MAX_P95_LATENCY_MS=25.0

# === Benchmark de latência ===
BENCHMARK_RUNS=500
BENCHMARK_WARMUP=50

# === Credenciais locais da stack de observabilidade ===
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
AIRFLOW_JWT_SECRET=fase3-triagem-dev-secret
