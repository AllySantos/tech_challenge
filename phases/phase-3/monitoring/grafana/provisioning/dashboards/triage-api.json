          "editorMode": "code",
          "expr": "sum(rate(triage_requests_total{status_code=~\"4..\"}[1m]))",
          "legendFormat": "4xx — cliente",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "triage-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(triage_requests_total{status_code=~\"5..\"}[1m]))",
