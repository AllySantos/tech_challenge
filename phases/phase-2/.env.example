# Phase 2 — example environment variables
# Copy this file to .env and fill in the values. .env is gitignored.

# === Seeds & reproducibility ===
SEED=42

# === Paths ===
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=recsys-phase-2

# === DVC remote (opcional — local por padrão) ===
# DVC_REMOTE_URL=s3://your-bucket/dvc-store
# AWS_PROFILE=default

# === Training hyperparameters (defaults — sobrescreva via configs/ na Etapa 1) ===
BATCH_SIZE=256
LEARNING_RATE=0.001
NUM_EPOCHS=20
EMBEDDING_DIM=64
EARLY_STOPPING_PATIENCE=3
